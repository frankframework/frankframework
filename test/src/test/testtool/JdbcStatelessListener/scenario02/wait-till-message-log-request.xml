				<name>TKEY</name>
			</column>
			<column>
				<name>TCHAR</name>
			</column>
			<column>
				<name>TNUMBER</name>
			</column>
			<column>
				<name>TVARCHAR</name>
			</column>
		</columns>
		<where>TCHAR = 'E' AND TNUMBER=${jdbc.statelesslistener.key}</where>
