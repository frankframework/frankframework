			</column>
			<column>
				<name>TYPE</name>
			</column>
			<column>
				<name>SLOTID</name>
			</column>
			<column>
				<name>MESSAGEID</name>
			</column>
			<column>
				<name>CORRELATIONID</name>
			</column>
		</columns>
		<where>SLOTID = 'JmsUntransacted-${listener.type}-Acknowledge-${listener.acknowledgeMode}' and TYPE = 'A'</where>
