<module name="CryptoSoapValidators">

	<adapter name="CryptoSoapValidator">
		<receiver>
			<listener className="org.frankframework.http.WebServiceListener" name="CryptoSoapListener" address="CryptoSoapValidator" soap="false"/>
		</receiver>
		<pipeline>
			<exits>
				<exit name="EXIT" state="success" code="200"/>
				<exit name="SpecialExit" state="success" code="201" responseRoot="SpecialResponse" />
				<exit name="NotModified" state="success" code="304" empty="true" />
				<exit name="BadRequest" state="error" code="400" responseRoot="InputValidationFailure" />
				<exit name="ServerError" state="error" code="500" />
			</exits>

			<CryptoSoapInputValidator
				schemaLocation="urn:items /Validators/xsd/Items%20v1.xsd"
				soapBody="Item_Request"
				soapVersion="auto"
				operations="VERIFY,DECRYPT"
			>
				<keystore resource="soap-sign-encryption.jks" password="changeit" type="JKS" keystoreAlias="myCustomCertificateName"  keystoreAliasPassword="Super$3cure" />
				<param name="Status" sessionKey="Status" />
				<param name="Id" sessionKey="Id" />
				<param name="Item/Id" sessionKey="ItemId" />
				<param name="Attributes/Attribute/Id" sessionKey="AttributeId" />
				<forward name="failure" path="InputValidationFailure" />
			</CryptoSoapInputValidator>

			<CryptoSoapOutputValidator
				schemaLocation="urn:items /Validators/xsd/Items%20v1.xsd"
				soapBody="Item_Response,InputValidationFailure"
				soapVersion="auto"
				operations="SIGN,ENCRYPT"
			>
				<keystore resource="soap-sign-encryption.jks" password="changeit" type="JKS" keystoreAlias="myCustomCertificateName"  keystoreAliasPassword="Super$3cure" />
				<param name="Status" sessionKey="Status" />
				<param name="Id" sessionKey="Id" />
				<param name="Item/Id" sessionKey="ItemId" />
				<param name="Attributes/Attribute/Id" sessionKey="AttributeId" />
				<forward name="failure" path="InputValidationFailure" />
			</CryptoSoapOutputValidator>

			<!-- since we don't use the auto-wrap, explicitly configure the wrappers -->
			<SoapInputWrapper direction="unwrap" />
			<SoapOutputWrapper />

			<pipe name="CopyItem" className="org.frankframework.pipes.XsltPipe" styleSheetName="Validators/xsl/CopyItem.xsl">
				<forward name="success" path="EXIT" />
			</pipe>

			<EchoPipe name="InputValidationFailure" getInputFromFixedValue="&lt;InputValidationFailure xmlns=&quot;urn:items&quot;/&gt;">
				<forward name="success" path="EXIT" />
			</EchoPipe>

		</pipeline>
	</adapter>

	<adapter name="WebServiceCryptoSoap" description="Test the functioning of the WebServiceSender with Crypto">
		<receiver>
			<listener className="org.frankframework.receivers.JavaListener" serviceName="ibis4test-WebServiceSenderCrypto" />
		</receiver>
		<pipeline>
			<exits>
				<exit name="EXIT" state="success" />
				<exit name="InputValidationFailure" state="ERROR" />
			</exits>
			<SwitchPipe name="SwitchAction" xpathExpression="/Envelope/Body/Item_Request/Status" />
			<!-- I'm sorry, 'a' isn't a descriptive forward, but I was too lazy to edit the XSD. -->
			<SenderPipe name="a">
				<WebServiceSender
					url="${web.protocol}://${web.host}:${web.port}${web.contextpath}/services/CryptoSoapValidator"
					soap="false"
					allowSelfSignedCertificates="true"
					verifyHostname="false"
					timeout="1000"
				/>
				<CryptoSoapInputValidator
					schemaLocation="urn:items /Validators/xsd/Items%20v1.xsd"
					soapBody="Item_Request"
					soapVersion="auto"
					operations="SIGN,ENCRYPT"
				>
					<keystore resource="soap-sign-encryption.jks" password="changeit" type="JKS" keystoreAlias="myCustomCertificateName"  keystoreAliasPassword="Super$3cure" />
					<forward name="failure" path="InputValidationFailure" />
				</CryptoSoapInputValidator>
				<CryptoSoapOutputValidator
					schemaLocation="urn:items /Validators/xsd/Items%20v1.xsd"
					soapBody="Item_Response,InputValidationFailure"
					soapVersion="auto"
					operations="VERIFY,DECRYPT"
				>
					<keystore resource="soap-sign-encryption.jks" password="changeit" type="JKS" keystoreAlias="myCustomCertificateName"  keystoreAliasPassword="Super$3cure" />
					<forward name="failure" path="InputValidationFailure" />
				</CryptoSoapOutputValidator>
				<forward name="success" path="EXIT" />
			</SenderPipe>

		</pipeline>
	</adapter>

</module>
