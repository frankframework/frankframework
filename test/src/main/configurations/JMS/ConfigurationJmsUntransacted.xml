<Module xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:noNamespaceSchemaLocation="https://schemas.frankframework.org/FrankConfig.xsd">

	<Adapter name="TestJmsUntransacted" active="${active.jms}">
		<Pipeline>
			<Exits>
				<Exit name="DONE" state="SUCCESS"/>
			</Exits>

			<ForPipe name="ForPipe">
				<Param name="stopAt" sessionKey="msg.count"/>
				<Forward name="stop" path="Return Count"/>
				<Forward name="continue" path="Send Test Message"/>
			</ForPipe>
			<SenderPipe name="Send Test Message">
				<JmsSender jmsRealm="qcf" destinationName="${jms.destination.i4testiaf_ff}">
					<Param name="SOURCE" value="${hostname}-TestJmsUntransacted"/>
					<Param name="TYPE" sessionKey="listener.type"/>
					<Param name="MODE" sessionKey="listener.acknowledgeMode"/>
				</JmsSender>
				<Forward name="success" path="ForPipe"/>
			</SenderPipe>

			<GetFromSessionPipe name="Return Count" sessionKey="msg.count"/>
		</Pipeline>
	</Adapter>

	<Adapter name="JmsUntransacted-Listener" active="${active.jms}">
		<Receiver transactionAttribute="NotSupported">
			<PullingJmsListener acknowledgeMode="auto" jmsRealm="qcf" destinationName="${jms.destination.i4testiaf_ff}" messageSelector="SOURCE='${hostname}-TestJmsUntransacted' and TYPE='Pull' and MODE='Auto'"/>
			<JdbcErrorStorage slotId="JmsUntransacted-Pull-Acknowledge-Auto"/>
			<JdbcMessageLog slotId="JmsUntransacted-Pull-Acknowledge-Auto"/>
		</Receiver>
		<Receiver transactionAttribute="NotSupported">
			<PullingJmsListener acknowledgeMode="client" jmsRealm="qcf" destinationName="${jms.destination.i4testiaf_ff}" messageSelector="SOURCE='${hostname}-TestJmsUntransacted' and TYPE='Pull' and MODE='Client'"/>
			<JdbcErrorStorage slotId="JmsUntransacted-Pull-Acknowledge-Client"/>
			<JdbcMessageLog slotId="JmsUntransacted-Pull-Acknowledge-Client"/>
		</Receiver>
		<Receiver transactionAttribute="NotSupported">
			<PushingJmsListener acknowledgeMode="auto" jmsRealm="qcf" destinationName="${jms.destination.i4testiaf_ff}" messageSelector="SOURCE='${hostname}-TestJmsUntransacted' and TYPE='Push' and MODE='Auto'"/>
			<JdbcErrorStorage slotId="JmsUntransacted-Push-Acknowledge-Auto"/>
			<JdbcMessageLog slotId="JmsUntransacted-Push-Acknowledge-Auto"/>
		</Receiver>
		<Receiver transactionAttribute="NotSupported">
			<PushingJmsListener acknowledgeMode="client" jmsRealm="qcf" destinationName="${jms.destination.i4testiaf_ff}" messageSelector="SOURCE='${hostname}-TestJmsUntransacted' and TYPE='Push' and MODE='Client'"/>
			<JdbcErrorStorage slotId="JmsUntransacted-Push-Acknowledge-Client"/>
			<JdbcMessageLog slotId="JmsUntransacted-Push-Acknowledge-Client"/>
		</Receiver>

		<Pipeline>
			<EchoPipe name="Echo-O-Oh"/>
		</Pipeline>
	</Adapter>
</Module>
